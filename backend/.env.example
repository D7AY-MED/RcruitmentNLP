# =====================================================================
# Backend environment variables (template).
# Copy needed values to the ROOT .env (matching project/.env).
# The backend reads from the root .env automatically.
# =====================================================================

# --- Database (Supabase PostgreSQL) ---
# Full SQLAlchemy connection string.
# NOTE: If your password contains @, use %40 instead.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# --- JWT authentication (recruiter auth) ---
# JWT_SECRET_KEY=generate_with: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=43200   # 1 month

# --- Supabase ---
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# JWT secret from Supabase Dashboard → Settings → API → JWT Secret
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# --- AI services ---
# GOOGLE_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_INTERVIEW_MODEL=gpt-4.1-mini

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# FRONTEND_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
# NEXT_PUBLIC_API_URL=http://localhost:8000
