# =====================================================================
# Backend environment variables template (Vite + FastAPI migration)
# =====================================================================

# --- Database ---
# SQLAlchemy PostgreSQL connection string. Used for recruiter auth and pools.
DATABASE_URL=your_postgresql_connection_string_here

# --- Supabase Admin & Auth Integration ---
# Required for bypass RLS operations on candidates, hr profiles, and administrators.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secret from Supabase Dashboard -> Settings -> API -> JWT Secret.
# Used for decoding and validating Supabase-issued Candidate JWT tokens.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# --- Recruiter Custom Auth ---
# Used for backend recruiter custom JWT generation and signing.
JWT_SECRET_KEY=generate_with:python_-c_"import_secrets;print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# --- Admin Bootstrap Auth ---
# Setup verification token for administrative bootstrapping endpoints (guarded registration).
# Header x-admin-setup-token must match this value to register the first admin.
ADMIN_SETUP_TOKEN=your_admin_setup_token_here

# --- Interview Configuration ---
# Number of questions in the adaptive interview sequence.
TOTAL_QUESTIONS=15
