# =====================================================================
# Backend environment variables (template).
# Copy this file to ".env" and fill in real values. ".env" is gitignored.
# =====================================================================

# --- Database (Supabase PostgreSQL) ---
# Full SQLAlchemy connection string. Used by app/database.py.
# NOTE: never commit the real credentials — keep them only in .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# --- JWT authentication ---
# Secret used to sign login tokens. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440   # Token lifetime in minutes (1440 = 24h)

# --- CORS ---
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGINS=http://localhost:3000

# --- Existing services (unchanged) ---
SUPABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
