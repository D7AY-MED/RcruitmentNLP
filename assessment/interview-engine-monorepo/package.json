{
  "name": "interview-engine-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace apps/interview-backend run dev",
    "dev:renderer": "npm --workspace apps/interview-renderer run dev",
    "build": "npm --workspaces run build",
    "check": "npm --workspaces run check"
  }
}
